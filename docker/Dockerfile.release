# fandhe-browser の配布コンテナ（既定: V8 のみ / 軽量: boa のみ）。
#
# TASK-64（64.1・64.2・64.3）・CTR-1・CTR-4・MS-5。fandhe-browser-cli を
# musl の静的リンク単一バイナリ（x86_64 必須・aarch64 任意）としてビルドし、scratch イメージに
# バイナリ・CA 証明書バンドル・ライセンス文書・データディレクトリだけを入れる。
#   - default: 既定 feature（V8 のみ同梱）。--target 省略時もこちら（最終ステージ）。
#   - lite:    --no-default-features --features js-boa（boa のみ同梱）。
# リポジトリルートの開発用 Dockerfile（lint・テスト用）とは別物で、配布には使わない。
#
# ビルド: docker build -f docker/Dockerfile.release --target default -t fandhe-browser:default .
#         docker build -f docker/Dockerfile.release --target lite -t fandhe-browser:lite .
# aarch64（任意。TASK-64.3）: `--platform linux/arm64` を付ける。BuildKit が TARGETARCH=arm64 を設定し、
#   ビルダーのホスト三つ組が aarch64-unknown-linux-musl になる（クロスコンパイルはしない）。
#         docker buildx build -f docker/Dockerfile.release --platform linux/arm64 --target default --load -t fandhe-browser:default-arm64 .
#   x86_64 ホストでは QEMU（binfmt）が要り非常に遅いため、arm64 ネイティブホストでのビルドを推奨する。
#   （ビルドコンテキストは docker/Dockerfile.release.dockerignore の allowlist で絞られる）
#
# 設計（container-cloud.md の決定 1〜5）:
#   - v8 crate の musl 向け prebuilt をリンクする。V8_FROM_SOURCE は使わない（決定 3）。
#     リンクできない場合は glibc + distroless へ逃げず停止して報告する（決定 4・オーナー判断）。
#   - verify-* ステージで動的リンク 0 件を検査し、落ちたバイナリは最終イメージに入らない（CTR-4）。
#
# musl の版（Alpine の musl-1.2.6）は LICENSE-THIRD-PARTY 節 5 の COPYRIGHT 全文と連動する。
# docker/release-build.sh が版を検査し、不一致ならビルドを失敗させる。ベースイメージ更新時は
# 該当版の COPYRIGHT で節 5 と NOTICE の musl 行を更新してから検査値を差し替える。
#
# digest の更新手順: `docker buildx imagetools inspect rust:1-alpine` の
# digest（multi-arch manifest list）を転記する。ベースイメージを更新したら
# NOTICE の CA 証明書の版の記載も見直す。
#
# V8 prebuilt の SHA-256 ピン（RUSTY_V8_ARCHIVE_SHA256）はアーキ別で docker/release-build.sh が持つ。
FROM rust:1-alpine@sha256:0cce0a5e0e8ba67b455257a3a02a1d99005f382748789d6464460028810f1627 AS base

# ビルド専用ツール（配布イメージには入らない）。curl は v8 の prebuilt 取得、
# file / binutils は verify-* ステージの検査用、bash / jq は Cargo 依存のライセンス文書生成用。
RUN apk add --no-cache musl-dev curl file binutils bash jq

# BuildKit が --platform から設定する（amd64 / arm64）。release-build.sh が三つ組へ写像する。
ARG TARGETARCH

WORKDIR /build
# rust-toolchain.toml は意図的にコンテキストから外している（dockerignore 参照）。
# 含めるとイメージ内の rustup が stable と rustfmt / clippy をネットワーク経由で
# 追加導入し、digest 固定の再現性が崩れるため。配布ビルドに限る例外で、
# ツールチェーンの正本は rust-toolchain.toml のまま。
COPY . .

# 既定コンテナのビルド（V8）。feature は既定のまま。
FROM base AS build-default
ARG TARGETARCH
# target キャッシュは並列ビルド時の競合を避けるためフレーバー・アーキごとに id を分ける。
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target,id=fandhe-release-target-default-${TARGETARCH} \
    docker/release-build.sh "${TARGETARCH}" "" v8

# 軽量コンテナのビルド（boa）。フラグはここに固定し、--target lite だけでビルドできるようにする。
# js-boa を --features で足すだけでは両エンジン同梱になる（CTR-1 違反）ため --no-default-features が必須。
FROM base AS build-lite
ARG TARGETARCH
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target,id=fandhe-release-target-lite-${TARGETARCH} \
    docker/release-build.sh "${TARGETARCH}" "--no-default-features --features js-boa" boa_engine

# 静的リンク検査（CTR-4・決定 5）。検査ロジックは docker/verify-static.sh。
FROM build-default AS verify-default
RUN docker/verify-static.sh /out/fandhe-browser

FROM build-lite AS verify-lite
RUN docker/verify-static.sh /out/fandhe-browser

# 軽量コンテナ。構成は default と同じ（バイナリ・CA 証明書バンドル・ライセンス文書・
# 非 root 用データディレクトリのみ。64.1 からの構成を継承）。
FROM scratch AS lite
COPY --from=verify-lite /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=verify-lite /out/fandhe-browser /fandhe-browser
COPY --from=verify-lite /out/licenses /licenses
COPY --from=verify-lite --chown=65532:65532 /out/data /data
ENV HOME=/data \
    XDG_DATA_HOME=/data
USER 65532:65532
ENTRYPOINT ["/fandhe-browser"]

# 既定コンテナ。--target 省略時にビルドされるよう、ファイル末尾（最終ステージ）に置く。
# 中身はバイナリ・CA 証明書バンドル（Alpine 由来・無改変）・ライセンス文書・
# 非 root 用のデータディレクトリだけ。CA 証明書の帰属表示は NOTICE / LICENSE-THIRD-PARTY
# （OSS-2・TASK-76）。静的リンクした V8 等の著作権表示・ライセンス条文を配布イメージ単体で
# 受領者へ渡すため、これらを /licenses/ へ同梱する。
FROM scratch AS default
COPY --from=verify-default /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=verify-default /out/fandhe-browser /fandhe-browser
COPY --from=verify-default /out/licenses /licenses
# プロファイル保存先（OsDefaultStore は $XDG_DATA_HOME/fandhe-browser を使う）。
# scratch には HOME も書き込み可能なディレクトリも無いため、UID 65532 所有の /data を用意する。
COPY --from=verify-default --chown=65532:65532 /out/data /data
ENV HOME=/data \
    XDG_DATA_HOME=/data
# scratch には /etc/passwd が無いため数値 UID で非 root 実行にする。
USER 65532:65532
ENTRYPOINT ["/fandhe-browser"]
